From e0a7f8677c6dc245336a7243a0d2311b8adddf3e Mon Sep 17 00:00:00 2001
From: Danylo Storozhev <office@storozhev.net>
Date: Mon, 23 Mar 2026 23:21:51 +0100
Subject: [PATCH] fix: route overlay alpha sysfs writes through DRM atomic
 commits

The overlay_alpha_store() sysfs handler was calling
ipu_dp_set_global_alpha() directly, bypassing the DRM atomic pipeline.
This races with Qt's atomic commits which also reprogram the DP alpha
registers through ipu_plane_atomic_update(). The two unsynchronized
code paths writing to the same DP hardware registers cause visible
flicker.

Route all alpha changes through imx_overlay_atomic_commit() instead,
which uses the DRM atomic state machinery with proper modeset locking.
This eliminates the register-level race between sysfs writes and
Qt's page flips.
---
 drivers/gpu/drm/imx/ipuv3/imx-drm-core.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/imx/ipuv3/imx-drm-core.c b/drivers/gpu/drm/imx/ipuv3/imx-drm-core.c
index f40d14477a04..4a97f310ac99 100644
--- a/drivers/gpu/drm/imx/ipuv3/imx-drm-core.c
+++ b/drivers/gpu/drm/imx/ipuv3/imx-drm-core.c
@@ -58,6 +58,8 @@ struct imx_overlay_fbdev {
 
 static struct imx_overlay_fbdev *g_overlay;
 
+static int imx_overlay_atomic_commit(struct imx_overlay_fbdev *ofb, u16 alpha);
+
 static int imx_overlay_fb_mmap(struct fb_info *info, struct vm_area_struct *vma)
 {
 	struct imx_overlay_fbdev *ofb = info->par;
@@ -92,8 +94,8 @@ static ssize_t overlay_alpha_store(struct device *dev,
 				   const char *buf, size_t count)
 {
 	struct imx_overlay_fbdev *ofb = g_overlay;
-	struct ipu_plane *ipu_plane;
 	unsigned int alpha;
+	int ret;
 
 	if (!ofb || !ofb->active)
 		return -ENODEV;
@@ -103,9 +105,9 @@ static ssize_t overlay_alpha_store(struct device *dev,
 
 	ofb->alpha = alpha;
 
-	ipu_plane = to_ipu_plane(ofb->overlay);
-	if (ipu_plane->dp)
-		ipu_dp_set_global_alpha(ipu_plane->dp, true, alpha, false);
+	ret = imx_overlay_atomic_commit(ofb, (u16)alpha << 8 | alpha);
+	if (ret)
+		return ret;
 
 	return count;
 }
