From: Librescoot <dev@librescoot.org>
Date: Sat, 5 Sep 2026 00:00:00 +0200
Subject: [PATCH] ASoC: fsl: add i.MX TAS5720 machine driver

simple-audio-card cannot drive this board's audio: the SSI reaches the
TAS5720 through AUDMUX, and the amplifier's master clock is supplied by
the i.MX6 clock output. Without both, the codec latches a clock error and
playback remains silent.

Upstream-Status: Inappropriate [board-specific machine driver]
---
diff --git a/sound/soc/fsl/imx-tas5720.c b/sound/soc/fsl/imx-tas5720.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/sound/soc/fsl/imx-tas5720.c
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * ASoC machine driver for i.MX boards with a TAS5720 amplifier.
+ *
+ * The SSI reaches the codec through AUDMUX, and the codec master clock is
+ * supplied by the i.MX6 clock output.
+ */
+
+#include <linux/clk.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <sound/soc.h>
+
+#include "imx-audmux.h"
+
+struct imx_tas5720_data {
+	struct clk *mclk;
+};
+
+static const struct snd_soc_dapm_widget imx_tas5720_dapm_widgets[] = {
+	SND_SOC_DAPM_SPK("Output", NULL),
+};
+
+static int imx_audmux_config(int int_port, int ext_port)
+{
+	unsigned int ptcr, pdcr;
+
+	/* The reference manual numbers ports from 1, the API from 0. */
+	int_port--;
+	ext_port--;
+
+	ptcr = IMX_AUDMUX_V2_PTCR_SYN |
+	       IMX_AUDMUX_V2_PTCR_TFSDIR |
+	       IMX_AUDMUX_V2_PTCR_TFSEL(int_port) |
+	       IMX_AUDMUX_V2_PTCR_TCLKDIR |
+	       IMX_AUDMUX_V2_PTCR_TCSEL(int_port);
+	pdcr = IMX_AUDMUX_V2_PDCR_RXDSEL(int_port);
+	imx_audmux_v2_configure_port(ext_port, ptcr, pdcr);
+
+	/* RCLKDIR and SYN must not change in the same write. */
+	ptcr |= IMX_AUDMUX_V2_PTCR_RFSDIR |
+		IMX_AUDMUX_V2_PTCR_RFSEL(int_port) |
+		IMX_AUDMUX_V2_PTCR_RCLKDIR |
+		IMX_AUDMUX_V2_PTCR_RCSEL(int_port);
+	imx_audmux_v2_configure_port(ext_port, ptcr, pdcr);
+
+	ptcr = IMX_AUDMUX_V2_PTCR_SYN;
+	pdcr = IMX_AUDMUX_V2_PDCR_RXDSEL(ext_port);
+	imx_audmux_v2_configure_port(int_port, ptcr, pdcr);
+
+	return 0;
+}
+
+static int imx_tas5720_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct imx_tas5720_data *data = snd_soc_card_get_drvdata(rtd->card);
+
+	return clk_prepare_enable(data->mclk);
+}
+
+static void imx_tas5720_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct imx_tas5720_data *data = snd_soc_card_get_drvdata(rtd->card);
+
+	clk_disable_unprepare(data->mclk);
+}
+
+static const struct snd_soc_ops imx_tas5720_ops = {
+	.startup = imx_tas5720_startup,
+	.shutdown = imx_tas5720_shutdown,
+};
+
+SND_SOC_DAILINK_DEFS(hifi,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "tas5720-amplifier")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link imx_tas5720_dai = {
+	.name = "imx-tas5720",
+	.stream_name = "imx-tas5720",
+	.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+		   SND_SOC_DAIFMT_CBC_CFC,
+	.ops = &imx_tas5720_ops,
+	SND_SOC_DAILINK_REG(hifi),
+};
+
+static struct snd_soc_card imx_tas5720_card = {
+	.name = "imx-audio-tas5720",
+	.owner = THIS_MODULE,
+	.dai_link = &imx_tas5720_dai,
+	.num_links = 1,
+	.dapm_widgets = imx_tas5720_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(imx_tas5720_dapm_widgets),
+};
+
+static int imx_tas5720_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &imx_tas5720_card;
+	struct device_node *np = pdev->dev.of_node;
+	struct device_node *ssi_np = NULL, *codec_np = NULL;
+	struct platform_device *ssi_pdev;
+	struct imx_tas5720_data *data;
+	struct i2c_client *codec_dev;
+	int int_port, ext_port;
+	int ret;
+
+	data = devm_kzalloc(&pdev->dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	data->mclk = devm_clk_get(&pdev->dev, "mclk");
+	if (IS_ERR(data->mclk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(data->mclk),
+				     "failed to get master clock\n");
+
+	ret = of_property_read_u32(np, "mux-int-port", &int_port);
+	if (ret) {
+		dev_err(&pdev->dev, "mux-int-port missing or invalid\n");
+		return ret;
+	}
+
+	ret = of_property_read_u32(np, "mux-ext-port", &ext_port);
+	if (ret) {
+		dev_err(&pdev->dev, "mux-ext-port missing or invalid\n");
+		return ret;
+	}
+
+	imx_audmux_config(int_port, ext_port);
+
+	ssi_np = of_parse_phandle(np, "ssi-controller", 0);
+	codec_np = of_parse_phandle(np, "audio-codec", 0);
+	if (!ssi_np || !codec_np) {
+		dev_err(&pdev->dev, "phandle missing or invalid\n");
+		ret = -EINVAL;
+		goto fail;
+	}
+
+	ssi_pdev = of_find_device_by_node(ssi_np);
+	if (!ssi_pdev) {
+		ret = -EPROBE_DEFER;
+		goto fail;
+	}
+	put_device(&ssi_pdev->dev);
+
+	codec_dev = of_find_i2c_device_by_node(codec_np);
+	if (!codec_dev) {
+		ret = -EPROBE_DEFER;
+		goto fail;
+	}
+	put_device(&codec_dev->dev);
+
+	imx_tas5720_dai.cpus->of_node = ssi_np;
+	imx_tas5720_dai.platforms->of_node = ssi_np;
+	imx_tas5720_dai.codecs->of_node = codec_np;
+
+	card->dev = &pdev->dev;
+	ret = snd_soc_of_parse_audio_routing(card, "audio-routing");
+	if (ret)
+		goto fail;
+
+	platform_set_drvdata(pdev, card);
+	snd_soc_card_set_drvdata(card, data);
+
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret) {
+		dev_err_probe(&pdev->dev, ret, "failed to register card\n");
+		goto fail;
+	}
+
+	of_node_put(ssi_np);
+	of_node_put(codec_np);
+
+	return 0;
+
+fail:
+	of_node_put(ssi_np);
+	of_node_put(codec_np);
+	return ret;
+}
+
+static const struct of_device_id imx_tas5720_dt_ids[] = {
+	{ .compatible = "librescoot,imx-audio-tas5720", },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx_tas5720_dt_ids);
+
+static struct platform_driver imx_tas5720_driver = {
+	.driver = {
+		.name = "imx-tas5720",
+		.pm = &snd_soc_pm_ops,
+		.of_match_table = imx_tas5720_dt_ids,
+	},
+	.probe = imx_tas5720_probe,
+};
+module_platform_driver(imx_tas5720_driver);
+
+MODULE_DESCRIPTION("i.MX TAS5720 ASoC machine driver");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:imx-tas5720");
diff --git a/sound/soc/fsl/Kconfig b/sound/soc/fsl/Kconfig
index 1111111..2222222 100644
--- a/sound/soc/fsl/Kconfig
+++ b/sound/soc/fsl/Kconfig
@@ -370,6 +370,17 @@
 	  with OF-graph DT bindings.
 	  It also support DPCM of single CPU multi Codec ststem.
 
+config SND_SOC_IMX_TAS5720
+	tristate "SoC Audio support for i.MX boards with a TAS5720"
+	depends on OF && I2C
+	select SND_SOC_TAS5720
+	select SND_SOC_IMX_PCM_DMA
+	select SND_SOC_IMX_AUDMUX
+	select SND_SOC_FSL_SSI
+	help
+	  Say Y if you want to add support for SoC audio on an i.MX board with
+	  a TAS5720 amplifier connected over AUDMUX.
+
 endif # SND_IMX_SOC
 
 endmenu
diff --git a/sound/soc/fsl/Makefile b/sound/soc/fsl/Makefile
index 1111111..2222222 100644
--- a/sound/soc/fsl/Makefile
+++ b/sound/soc/fsl/Makefile
@@ -71,6 +71,7 @@
 snd-soc-imx-hdmi-y := imx-hdmi.o
 snd-soc-imx-rpmsg-y := imx-rpmsg.o
 snd-soc-imx-card-y := imx-card.o
+snd-soc-imx-tas5720-y := imx-tas5720.o
 
 obj-$(CONFIG_SND_SOC_EUKREA_TLV320) += snd-soc-eukrea-tlv320.o
 obj-$(CONFIG_SND_SOC_IMX_ES8328) += snd-soc-imx-es8328.o
@@ -79,3 +80,4 @@
 obj-$(CONFIG_SND_SOC_IMX_HDMI) += snd-soc-imx-hdmi.o
 obj-$(CONFIG_SND_SOC_IMX_RPMSG) += snd-soc-imx-rpmsg.o
 obj-$(CONFIG_SND_SOC_IMX_CARD) += snd-soc-imx-card.o
+obj-$(CONFIG_SND_SOC_IMX_TAS5720) += snd-soc-imx-tas5720.o
