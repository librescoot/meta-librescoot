+// Same attributes, uniforms and paint properties as FillExtrusionProgram, so
+// the layer can feed it identical bindings. Only the GLSL differs: it computes
+// gl_Position and nothing else, which is all the depth prepass consumes.
+class FillExtrusionDepthProgram final : public Program<FillExtrusionDepthProgram,
+                                                       shaders::BuiltIn::FillExtrusionDepthProgram,
+                                                       gfx::PrimitiveType::Triangle,
+                                                       FillExtrusionLayoutAttributes,
+                                                       FillExtrusionUniforms,
+                                                       TypeList<>,
+                                                       style::FillExtrusionPaintProperties> {
+public:
+    static constexpr std::string_view Name{"FillExtrusionDepthProgram"};
+    const std::string_view typeName() const noexcept override { return Name; }
+
+    using Program::Program;
+};
+
