[Unit]
Description=ScootUI Application
Documentation=https://github.com/librescoot/meta-librescoot

Requires=systemd-user-sessions.service
After=systemd-user-sessions.service

After=plymouth-quit-wait.service

Conflicts=dbc-dispatcher.service
ConditionPathExists=/dev/tty0

[Service]
Environment=HOME="/data"
Environment=XDG_RUNTIME_DIR="/run/user/0"
Environment=FLUTTER_FB_DEVICE="/dev/fb1"
ExecStart=/usr/bin/flutter-fbdev-backend -b /usr/share/flutter/scootui/3.32.5/release

User=root
Group=root

WorkingDirectory=/usr/share/flutter/scootui/3.32.5/release

StandardOutput=journal
StandardError=journal

# Auto-restart on crash/quit
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
