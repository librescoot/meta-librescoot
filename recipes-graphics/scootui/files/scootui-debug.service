[Unit]
Description=ScootUI Application (Debug Mode)
Documentation=https://github.com/librescoot/meta-librescoot

Requires=systemd-user-sessions.service
After=systemd-user-sessions.service

After=plymouth-quit-wait.service

# Ensure Weston is available
Requires=weston.socket
After=weston.socket

ConditionPathExists=/dev/tty0

[Service]
Environment=HOME="/data"
Environment=WAYLAND_DISPLAY="/run/wayland-0"
Environment=XDG_RUNTIME_DIR="/run/user/0"
Environment=VM_SERVICE_PORT="8181"
ExecStart=/usr/bin/scootui-launch debug

User=root
Group=root

# Working directory will be set by the launcher script

StandardOutput=journal
StandardError=journal

# Debug mode should restart on failure for development
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target