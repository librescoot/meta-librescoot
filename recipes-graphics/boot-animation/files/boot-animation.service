[Unit]
Description=Boot Animation
DefaultDependencies=no
After=systemd-remount-fs.service
Before=multi-user.target
ConditionPathExists=/dev/fb0

[Service]
ExecStartPre=/bin/sh -c "echo 0 > /sys/class/vtconsole/vtcon1/bind"
ExecStart=/bin/sh -c 'ANIM=$(sed -n "s/.*boot\.animation=\([^ ]*\).*/\1/p" /proc/cmdline); exec /usr/bin/boot-animation /usr/share/boot-animation/${ANIM:-librescoot}.json --fps 25 --once --fade-ms 1000'
Type=notify
NotifyAccess=main

[Install]
WantedBy=sysinit.target
