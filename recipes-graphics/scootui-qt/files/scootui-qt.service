[Unit]
Description=ScootUI Qt Application
Documentation=https://github.com/librescoot/scootui-qt
DefaultDependencies=no

After=systemd-journald.socket
Wants=systemd-networkd.service
Conflicts=scootui.service shutdown.target
Before=shutdown.target
ConditionPathExists=/dev/tty0

[Service]
Environment=LANG=C.UTF-8
Environment=HOME="/data"
Environment=XDG_RUNTIME_DIR="/run/user/0"
Environment=MESA_SHADER_CACHE_DIR=/var/volatile/mesa_shader_cache
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_fbdev
Environment=EGLFS_FBDEV_FB_DEVICE=/dev/fb1
Environment=EGLFS_FBDEV_RENDER_DEVICE=/dev/dri/renderD128
Environment=QT_QPA_EGLFS_SWAPINTERVAL=1
Environment=QSG_RENDER_LOOP=basic
Environment=QT_PLUGIN_PATH=/usr/plugins:/usr/lib/plugins
RuntimeDirectory=user/0
ExecStart=/usr/bin/scootui-qt

User=root
Group=root

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=1

# Give scootui time to render the blackout frame before SIGKILL
TimeoutStopSec=3s

[Install]
WantedBy=multi-user.target
