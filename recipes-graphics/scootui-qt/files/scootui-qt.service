[Unit]
Description=ScootUI Qt Application
Documentation=https://github.com/librescoot/scootui-qt
DefaultDependencies=no

After=systemd-journald.socket
Wants=systemd-networkd.service
Conflicts=scootui.service shutdown.target
Before=shutdown.target
ConditionPathExists=/dev/tty0

[Service]
Environment=LANG=C.UTF-8
Environment=HOME="/data"
# /data mounts several seconds after the dashboard starts; Qt's qml, pipeline
# and shader caches must not land on the rootfs under the mountpoint.
Environment=XDG_CACHE_HOME=/var/volatile/cache
Environment=XDG_RUNTIME_DIR="/run/user/0"
Environment=MESA_SHADER_CACHE_DIR=/var/volatile/mesa_shader_cache
Environment=QT_QPA_PLATFORM=eglfs
# Render with the GPU render node but copy each frame to the fb1 overlay.
# This deliberately never opens card1 or becomes DRM master, so the boot
# animation remains live on fb0 until the overlay alpha handoff.
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_fbdev
Environment=EGLFS_FBDEV_FB_DEVICE=/dev/fb1
Environment=EGLFS_FBDEV_RENDER_DEVICE=/dev/dri/renderD128
Environment=QT_QPA_EGLFS_SWAPINTERVAL=1
Environment=QSG_RENDER_LOOP=basic
Environment=QT_PLUGIN_PATH=/usr/plugins:/usr/lib/plugins
# No touch or key input on the DBC: buttons arrive through Redis. Skipping
# the evdev/libinput setup saves ~0.1s in QGuiApplication's constructor.
Environment=QT_QPA_EGLFS_DISABLE_INPUT=1
# The DBC has two cores and they are saturated for the first ~14s of boot
# (udev coldplug, resolved, networkd, journald). At the default priority the
# dashboard gets 20-30% of one core and its first frame lands at ~15.8s; at
# nice -10 it gets the CPU when it is runnable and the first frame lands at
# ~10.8s. CPUWeight alone measured no effect on this image.
Nice=-10
RuntimeDirectory=user/0
# Keep the dashboard overlay hidden until it has rendered its first frame.
# Application::fadeInOverlay then makes the live 0→255 handoff from fb0.
ExecStartPre=/usr/bin/imx-overlay-alpha 0
ExecStart=/usr/bin/scootui-qt

User=root
Group=root

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=1

# Give scootui time to render the blackout frame before SIGKILL
TimeoutStopSec=3s

[Install]
WantedBy=multi-user.target
