[Unit]
Description=ScootUI Qt Application
Documentation=https://github.com/librescoot/scootui-qt
DefaultDependencies=no

After=systemd-networkd.service systemd-journald.socket
Wants=systemd-networkd.service
Conflicts=scootui.service shutdown.target
Before=shutdown.target
ConditionPathExists=/dev/tty0

[Service]
Environment=LANG=C.UTF-8
Environment=HOME="/data"
Environment=XDG_RUNTIME_DIR="/run/user/0"
# Persist the shader cache on /data instead of tmpfs. tmpfs is wiped on every
# (hard) power cut, so the first frame recompiles all pipelines each cold boot.
# /data survives reboots, so post-first-boot cold starts reuse compiled shaders.
# Bounded so it can't grow unbounded on the data partition.
Environment=MESA_SHADER_CACHE_DIR=/data/mesa_shader_cache
Environment=MESA_SHADER_CACHE_MAX_SIZE=64M
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_KMS_CONFIG=/etc/scootui-qt-kms.json
Environment=QT_QPA_EGLFS_KMS_ATOMIC=1
Environment=QT_QPA_EGLFS_SWAPINTERVAL=1
Environment=QSG_RENDER_LOOP=basic
Environment=QT_PLUGIN_PATH=/usr/plugins:/usr/lib/plugins
RuntimeDirectory=user/0
ExecStart=/usr/bin/scootui-qt

User=root
Group=root

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=1

# Give scootui time to render the blackout frame before SIGKILL
TimeoutStopSec=3s

[Install]
WantedBy=multi-user.target
