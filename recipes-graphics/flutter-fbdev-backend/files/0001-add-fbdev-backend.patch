@@ -0,0 +1,236 @@
+// Copyright 2024 LibreScoot contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/linux_embedded/window/native_window_fbdev.h"
+
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cstring>
+
+#include "flutter/shell/platform/linux_embedded/logger.h"
+#include "flutter/shell/platform/linux_embedded/surface/context_egl.h"
+
+namespace flutter {
+
+NativeWindowFbdev::NativeWindowFbdev(const char* fb_device_filename,
+                                     const char* render_device_filename,
+                                     const uint16_t rotation,
+                                     bool enable_vsync) {
+  // Open the framebuffer device.
+  fb_fd_ = open(fb_device_filename, O_RDWR);
+  if (fb_fd_ < 0) {
+    ELINUX_LOG(ERROR) << "Couldn't open " << fb_device_filename;
+    return;
+  }
+
+  if (ioctl(fb_fd_, FBIOGET_VSCREENINFO, &fb_vinfo_) < 0) {
+    ELINUX_LOG(ERROR) << "FBIOGET_VSCREENINFO failed";
+    close(fb_fd_);
+    fb_fd_ = -1;
+    return;
+  }
+
+  if (ioctl(fb_fd_, FBIOGET_FSCREENINFO, &fb_finfo_) < 0) {
+    ELINUX_LOG(ERROR) << "FBIOGET_FSCREENINFO failed";
+    close(fb_fd_);
+    fb_fd_ = -1;
+    return;
+  }
+
+  fb_bpp_ = fb_vinfo_.bits_per_pixel;
+  fb_stride_ = fb_finfo_.line_length;
+  fb_is_rgb565_ = (fb_bpp_ == 16 && fb_vinfo_.red.offset == 11 &&
+                   fb_vinfo_.green.offset == 5 && fb_vinfo_.blue.offset == 0);
+
+  ELINUX_LOG(INFO) << "Framebuffer: " << fb_vinfo_.xres << "x"
+                   << fb_vinfo_.yres << " " << fb_bpp_ << "bpp"
+                   << " stride=" << fb_stride_
+                   << (fb_is_rgb565_ ? " RGB565" : "");
+
+  fb_map_size_ = fb_finfo_.smem_len;
+  fb_map_ = static_cast<uint8_t*>(
+      mmap(nullptr, fb_map_size_, PROT_WRITE, MAP_SHARED, fb_fd_, 0));
+  if (fb_map_ == MAP_FAILED) {
+    ELINUX_LOG(ERROR) << "Failed to mmap framebuffer";
+    fb_map_ = nullptr;
+    close(fb_fd_);
+    fb_fd_ = -1;
+    return;
+  }
+
+  // Open the GPU render node (no DRM master needed).
+  render_fd_ = open(render_device_filename, O_RDWR | O_CLOEXEC);
+  if (render_fd_ < 0) {
+    ELINUX_LOG(ERROR) << "Couldn't open render node " << render_device_filename;
+    munmap(fb_map_, fb_map_size_);
+    fb_map_ = nullptr;
+    close(fb_fd_);
+    fb_fd_ = -1;
+    return;
+  }
+
+  gbm_device_ = gbm_create_device(render_fd_);
+  if (!gbm_device_) {
+    ELINUX_LOG(ERROR) << "Couldn't create GBM device from render node";
+    close(render_fd_);
+    render_fd_ = -1;
+    munmap(fb_map_, fb_map_size_);
+    fb_map_ = nullptr;
+    close(fb_fd_);
+    fb_fd_ = -1;
+    return;
+  }
+
+  width_ = fb_vinfo_.xres;
+  height_ = fb_vinfo_.yres;
+  if (rotation == 90 || rotation == 270) {
+    std::swap(width_, height_);
+  }
+
+  enable_vsync_ = enable_vsync;
+
+  if (!CreateGbmSurface()) {
+    return;
+  }
+
+  valid_ = true;
+  ELINUX_LOG(INFO) << "FBDEV backend initialized: " << width_ << "x"
+                   << height_ << " render=" << render_device_filename
+                   << " fb=" << fb_device_filename;
+}
+
+NativeWindowFbdev::~NativeWindowFbdev() {
+  if (window_) {
+    gbm_surface_destroy(static_cast<gbm_surface*>(window_));
+    window_ = nullptr;
+  }
+  if (window_offscreen_) {
+    gbm_surface_destroy(static_cast<gbm_surface*>(window_offscreen_));
+    window_offscreen_ = nullptr;
+  }
+  if (gbm_device_) {
+    gbm_device_destroy(gbm_device_);
+    gbm_device_ = nullptr;
+  }
+  if (render_fd_ >= 0) {
+    close(render_fd_);
+    render_fd_ = -1;
+  }
+  if (fb_map_) {
+    munmap(fb_map_, fb_map_size_);
+    fb_map_ = nullptr;
+  }
+  if (fb_fd_ >= 0) {
+    close(fb_fd_);
+    fb_fd_ = -1;
+  }
+}
+
+std::unique_ptr<SurfaceGl> NativeWindowFbdev::CreateRenderSurface(
+    bool enable_impeller) {
+  return std::make_unique<SurfaceGl>(std::make_unique<ContextEgl>(
+      std::make_unique<EnvironmentEgl>(gbm_device_), enable_impeller));
+}
+
+bool NativeWindowFbdev::IsNeedRecreateSurfaceAfterResize() const {
+  return true;
+}
+
+bool NativeWindowFbdev::Resize(const size_t width, const size_t height) {
+  if (!valid_) {
+    ELINUX_LOG(ERROR) << "Failed to resize the window.";
+    return false;
+  }
+  ELINUX_LOG(INFO) << "resize: " << width << "x" << height;
+  if (window_) {
+    gbm_surface_destroy(static_cast<gbm_surface*>(window_));
+    window_ = nullptr;
+  }
+  return CreateGbmSurface();
+}
+
+void NativeWindowFbdev::SwapBuffers() {
+  auto* bo =
+      gbm_surface_lock_front_buffer(static_cast<gbm_surface*>(window_));
+  if (!bo) {
+    ELINUX_LOG(ERROR) << "Failed to lock GBM front buffer";
+    return;
+  }
+
+  uint32_t stride;
+  void* map_data = nullptr;
+  void* bo_data = gbm_bo_map(bo, 0, 0, gbm_bo_get_width(bo),
+                              gbm_bo_get_height(bo), GBM_BO_TRANSFER_READ,
+                              &stride, &map_data);
+  if (!bo_data) {
+    ELINUX_LOG(ERROR) << "Failed to map GBM buffer";
+    gbm_surface_release_buffer(static_cast<gbm_surface*>(window_), bo);
+    return;
+  }
+
+  auto src_width = gbm_bo_get_width(bo);
+  auto src_height = gbm_bo_get_height(bo);
+  auto dst_width = fb_vinfo_.xres;
+  auto dst_height = fb_vinfo_.yres;
+  auto copy_width = std::min(src_width, dst_width);
+  auto copy_height = std::min(src_height, dst_height);
+
+  auto* src = static_cast<uint8_t*>(bo_data);
+  auto* dst = fb_map_;
+
+  if (fb_is_rgb565_) {
+    // ARGB8888 → RGB565 conversion
+    for (uint32_t y = 0; y < copy_height; y++) {
+      auto* src_row = reinterpret_cast<const uint32_t*>(src + y * stride);
+      auto* dst_row = reinterpret_cast<uint16_t*>(dst + y * fb_stride_);
+      for (uint32_t x = 0; x < copy_width; x++) {
+        uint32_t pixel = src_row[x];
+        uint8_t r = (pixel >> 16) & 0xFF;
+        uint8_t g = (pixel >> 8) & 0xFF;
+        uint8_t b = pixel & 0xFF;
+        dst_row[x] =
+            ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
+      }
+    }
+  } else if (fb_bpp_ == 32) {
+    // Direct ARGB8888 copy
+    auto row_bytes = copy_width * 4;
+    for (uint32_t y = 0; y < copy_height; y++) {
+      memcpy(dst + y * fb_stride_, src + y * stride, row_bytes);
+    }
+  } else {
+    ELINUX_LOG(ERROR) << "Unsupported framebuffer format: " << fb_bpp_
+                      << "bpp";
+  }
+
+  gbm_bo_unmap(bo, map_data);
+  gbm_surface_release_buffer(static_cast<gbm_surface*>(window_), bo);
+}
+
+bool NativeWindowFbdev::CreateGbmSurface() {
+  // Render into ARGB8888 — we do the conversion in SwapBuffers.
+  // GBM_BO_USE_RENDERING only (no SCANOUT — we're not doing KMS).
+  window_ = gbm_surface_create(gbm_device_, fb_vinfo_.xres, fb_vinfo_.yres,
+                                GBM_FORMAT_ARGB8888, GBM_BO_USE_RENDERING);
+  if (!window_) {
+    ELINUX_LOG(ERROR) << "Failed to create GBM surface.";
+    valid_ = false;
+    return false;
+  }
+
+  window_offscreen_ = gbm_surface_create(gbm_device_, 1, 1,
+                                          GBM_FORMAT_ARGB8888,
+                                          GBM_BO_USE_RENDERING);
+  if (!window_offscreen_) {
+    ELINUX_LOG(ERROR) << "Failed to create offscreen GBM surface.";
+    return false;
+  }
+
+  return true;
+}
+
+}  // namespace flutter
