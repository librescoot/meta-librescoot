From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreScoot <librescoot@example.com>
Date: Sun, 2 Mar 2026 16:00:00 +0000
Subject: [PATCH] drm-gbm: use page flip instead of modeset for buffer swaps

Upstream-Status: Pending

The original code calls drmModeSetCrtc() on every SwapBuffers(), which
performs a full mode set (CRTC disable, reconfigure, enable) each frame.
This causes visible display flashing/tearing on every frame and is
unnecessary when the display mode never changes.

Replace with drmModePageFlip() which atomically swaps the framebuffer
pointer without touching display timing. The first frame still attempts
a page flip and falls back to drmModeSetCrtc() if the CRTC isn't yet
configured. EBUSY on subsequent frames means the previous flip is still
pending and the frame is safely skipped.

Signed-off-by: LibreScoot <librescoot@example.com>
---
 .../window/native_window_drm_gbm.cc          | 25 ++++++++++++++-----
 .../window/native_window_drm_gbm.h           |  1 +
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.cc b/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.cc
index 4565fcb..d5c43de 100644
--- a/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.cc
+++ b/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.cc
@@ -180,11 +180,24 @@ void NativeWindowDrmGbm::SwapBuffers() {
   }
   if (!drm_crtc_) {
     ELINUX_LOG(ERROR) << "crtc is null, cannot set mode.";
-  } else {
-    result = drmModeSetCrtc(drm_device_, drm_crtc_->crtc_id, fb, 0, 0,
-                            &drm_connector_id_, 1, &drm_mode_info_);
+  } else if (!crtc_set_) {
+    // First frame: try page flip (avoids modeset flash if CRTC is already
+    // active from kernel/fbcon). Fall back to full modeset if needed.
+    result = drmModePageFlip(drm_device_, drm_crtc_->crtc_id, fb, 0, nullptr);
     if (result != 0) {
-      ELINUX_LOG(ERROR) << "Failed to set crct mode. (" << result << ")";
+      result = drmModeSetCrtc(drm_device_, drm_crtc_->crtc_id, fb, 0, 0,
+                              &drm_connector_id_, 1, &drm_mode_info_);
+      if (result != 0) {
+        ELINUX_LOG(ERROR) << "Failed to set crtc mode. (" << result << ")";
+      }
+    }
+    crtc_set_ = true;
+  } else {
+    // Subsequent frames: page flip only (no modeset, no display reinit).
+    // EBUSY means previous flip is still pending — skip this frame.
+    result = drmModePageFlip(drm_device_, drm_crtc_->crtc_id, fb, 0, nullptr);
+    if (result != 0 && result != -EBUSY) {
+      ELINUX_LOG(ERROR) << "Failed to page flip. (" << result << ")";
     }
   }

diff --git a/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.h b/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.h
index d0a2ca5..1a107ec 100644
--- a/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.h
+++ b/src/flutter/shell/platform/linux_embedded/window/native_window_drm_gbm.h
@@ -54,6 +54,7 @@ class NativeWindowDrmGbm : public NativeWindowDrm {
   uint32_t gbm_previous_fb_;
   gbm_device* gbm_device_ = nullptr;
   gbm_bo* gbm_cursor_bo_ = nullptr;
+  bool crtc_set_ = false;
 };

 }  // namespace flutter
