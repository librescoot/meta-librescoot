[Unit]
Description=Hold /dev/dri/card1 open to suppress imx-drm lastclose modeset flash
DefaultDependencies=no
After=systemd-journald.socket
Before=scootui-qt.service
# Must outlive the shutdown transaction: the last close of card1 restores the
# fbdev mode, which the panel shows as a white flash before VBUS is cut.
IgnoreOnIsolate=yes
ConditionPathExists=/dev/dri/card1

[Service]
Type=simple
ExecStart=/usr/bin/drm-holder /dev/dri/card1
Restart=always
RestartSec=1

StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
