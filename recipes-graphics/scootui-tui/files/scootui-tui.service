[Unit]
Description=ScootUI TUI Dashboard
Documentation=https://github.com/librescoot/scootui-tui

After=basic.target

Conflicts=scootui.service scootui-qt.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
ExecStart=/usr/bin/scootui-tui
User=root
Group=root

StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
StandardError=journal
Environment=TERM=linux

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
