[Unit]
Description=Librescoot Battery Service
Requires=valkey.service
After=valkey.service
After=librescoot-vehicle.service
Wants=systemd-logind.service
After=systemd-logind.service dbus.socket

[Service]
Type=simple
User=root
Group=root
Nice=-10
ExecStart=/usr/bin/battery-service
Restart=always
KillMode=mixed

[Install]
WantedBy=multi-user.target
