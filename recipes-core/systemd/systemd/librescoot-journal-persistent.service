[Unit]
Description=Enable persistent journal storage when marker exists
Documentation=man:systemd-journald(8) man:journald.conf(5)
ConditionPathExists=/data/settings/journald-persistent
DefaultDependencies=no
RequiresMountsFor=/data
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target systemd-journal-flush.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /data/journal && chown root:systemd-journal /data/journal && chmod 2755 /data/journal && ln -sfn /data/journal /var/log/journal'

[Install]
WantedBy=sysinit.target
