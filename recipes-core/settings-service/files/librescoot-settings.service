[Unit]
Description=Librescoot Settings Service
Requires=redis.service
After=redis.service
# Always ensure /data is mounted (persisted settings live in /data/settings.toml)
RequiresMountsFor=/data
Wants=NetworkManager.service
Before=librescoot-vehicle.service

[Service]
# Type=notify: READY=1 is sent only after the settings hash has been seeded
# into Redis, so Before=librescoot-vehicle.service guarantees consumers see
# the seeded hash (Redis is not persisted; it starts empty every boot).
Type=notify
User=root
Group=root
ExecStart=/usr/bin/settings-service
Restart=always
RestartSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
