Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// 56 frames @ ~8.3fps (6.7s animation). Plymouth refresh fires at ~25Hz.
// frame_duration=3 → 8.33fps. Pre-load next frame during current frame's
// window (~120ms); ~30ms 8-bit PNG decode is invisible.
num_frames = 56;
frame_duration = 3;
frames = [];

frames[0] = Image("frames/frame-1.png");

anim_sprite = Sprite();
if (frames[0]) {
    anim_sprite.SetImage(frames[0]);
    image_width = frames[0].GetWidth();
    image_height = frames[0].GetHeight();
    anim_sprite.SetX((screen_width - image_width) / 2);
    anim_sprite.SetY((screen_height - image_height) / 2);
    anim_sprite.SetZ(1000);
}

current_frame = 0;
frame_counter = 0;
done = 0;

fade_duration = 25;
fade_tick = -1;
total_ticks = 0;

Plymouth.SetRefreshFunction(fun() {
    total_ticks++;

    if (fade_tick >= 0) {
        progress = (total_ticks - fade_tick) / fade_duration;
        if (progress > 1) {
            progress = 1;
        }
        anim_sprite.SetOpacity(1 - progress);
        return;
    }

    if (done) {
        return;
    }

    if (frame_counter == 0) {
        next = current_frame + 1;
        if (next < num_frames && !frames[next]) {
            frames[next] = Image("frames/frame-" + (next + 1) + ".png");
        }
    }

    frame_counter++;
    if (frame_counter >= frame_duration) {
        frame_counter = 0;
        current_frame++;
        if (current_frame >= num_frames) {
            done = 1;
            fade_tick = total_ticks;
            return;
        }
        if (frames[current_frame]) {
            anim_sprite.SetImage(frames[current_frame]);
        }
    }
});

Plymouth.SetQuitFunction(fun() {
});
