# LibreScoot Plymouth Boot Animation Script

# Set black background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Get screen dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Animation configuration
num_frames = 14;
frame_duration = 10; # Number of refresh cycles per frame (controls speed)

# Animation state
current_frame = 0;
frame_counter = 0;
animation_complete = 0;

# Load all animation frames into an array
frames = [];
for (i = 1; i <= num_frames; i++) {
    filename = "frames/frame-" + i + ".png";
    image = Image(filename);
    if (image) {
        frames[i-1] = image;
    }
}

# Create animation sprite
anim_sprite = Sprite();
if (frames[0]) {
    anim_sprite.SetImage(frames[0]);
    
    # Center the animation on screen
    image_width = frames[0].GetWidth();
    image_height = frames[0].GetHeight();
    anim_sprite.SetX((screen_width - image_width) / 2);
    anim_sprite.SetY((screen_height - image_height) / 2);
}

# Refresh function called every screen update
Plymouth.SetRefreshFunction(function() {
    if (!animation_complete && frames[current_frame]) {
        frame_counter++;
        
        # Advance frame when counter reaches duration
        if (frame_counter >= frame_duration) {
            frame_counter = 0;
            current_frame++;
            
            # Loop animation or stop at end
            if (current_frame >= num_frames) {
                current_frame = 0; # Loop the animation
                # animation_complete = 1; # Uncomment to stop after one cycle
            }
            
            # Update sprite with new frame
            if (frames[current_frame]) {
                anim_sprite.SetImage(frames[current_frame]);
            }
        }
    }
});

# Boot progress callback
Plymouth.SetBootProgressFunction(function(duration, progress) {
    # Animation continues regardless of boot progress
});

# Quit function
Plymouth.SetQuitFunction(function() {
    # Clean exit
});
