Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Get the screen dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Create a sprite that will contain our animation
anim_sprite = Sprite();

# Set the center position for our animation
anim_sprite.SetX(screen_width / 2);
anim_sprite.SetY(screen_height / 2);

# Define the number of frames and the frame rate
num_frames = 14;  # We have 14 animation frames for now
frame_rate = 30;  # Frames per second

# Load all animation frames
for (i = 1; i <= num_frames; i++) {
    filename = "frames/frame-" + i + ".png";
    anim_sprite.AddImage(Image(filename));
}

# Animation state
animation_done = 0;
current_frame = 0;

# Function to update the animation frame
fun UpdateAnimation() {
    if (animation_done == 0) {
        if (current_frame < num_frames - 1) {
            current_frame++;
            anim_sprite.SetImage(current_frame);
        } else {
            # Animation has completed, stay on last frame
            animation_done = 1;
        }
    }
}

# Handle plymouth events
Plymouth.SetRefreshFunction(function() {
    # This runs every refresh cycle
    if (animation_done == 0) {
        # Only advance the frame every 1/frame_rate seconds
        UpdateAnimation();
    }
});

Plymouth.SetQuitFunction(function() {
    # This function is called when plymouth is about to quit
    # Nothing special needed since we're not looping
});

# Display the first frame immediately
anim_sprite.SetImage(0);
