[Unit]
Description=Show Plymouth Boot Screen
DefaultDependencies=no
After=data.mount systemd-remount-fs.service
Wants=systemd-ask-password-plymouth.path
Before=systemd-ask-password-plymouth.service
ConditionKernelCommandLine=!plymouth.enable=0
ConditionVirtualization=!container
IgnoreOnIsolate=true

[Service]
ExecStartPre=-/bin/sh -c 'theme=$(cat /data/plymouth-theme 2>/dev/null | tr -dc "[:alnum:]_-"); [ -n "$theme" ] && printf "[Daemon]\nTheme=%%s\nShowDelay=0\nDeviceTimeout=5\nIgnoreSerialConsoles=yes\n" "$theme" > /etc/plymouth/plymouthd.conf'
ExecStart=/usr/sbin/plymouthd --mode=boot  --kernel-command-line="splash plymouth.ignore-serial-consoles" --pid-file=/run/plymouth/pid --attach-to-session
ExecStartPost=-/usr/bin/plymouth show-splash
Type=forking
RemainAfterExit=yes
KillMode=mixed
SendSIGKILL=no
