[Unit]
Description=Rescoot Uplink Service (Radio Gaga)
After=network.target valkey.service
Requires=valkey.service
ConditionPathExists=/data/radio-gaga/config.yaml

[Service]
Type=simple
WorkingDirectory=/data/radio-gaga
ExecStart=/usr/bin/radio-gaga -config /data/radio-gaga/config.yaml -buffer-persist-path /data/radio-gaga/telemetry-buffer.json
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
