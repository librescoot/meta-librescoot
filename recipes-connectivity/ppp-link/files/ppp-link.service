[Unit]
Description=PPP backup link over UART
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=simple
# pppd 2.5 locks the tty under /var/lock, a symlink into /run/lock
ExecStartPre=/bin/mkdir -p /run/lock
ExecStart=/usr/sbin/pppd call uart-link nodetach

# pppd may retain EXIT_USER_REQUEST (5) or EXIT_HANGUP (16) when systemd
# intentionally stops it after the peer has already closed the UART link.
# Treat both as clean for unit-state reporting. Restart=always still recovers
# every unexpected daemon exit; systemd suppresses restart for an explicit stop.
SuccessExitStatus=5 16
Restart=always
RestartSec=5

# pppd logs to syslog AND to its standard streams. Without this, every
# line lands in the journal twice: once via the syslog forwarder, once
# via systemd's capture of the foreground process. Discard both stdout
# and stderr to dedupe — pppd's own messages still reach the journal via
# syslog (journald associates them with this unit via cgroup).
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
