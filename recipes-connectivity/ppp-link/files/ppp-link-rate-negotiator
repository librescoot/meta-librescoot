#!/bin/sh

# Both peers boot at the baseline rate; MDB coordinates upgrades with local rollback.
BASE_RATE=250000
TARGET_RATE=2500000
RATE_FILE="${PPP_RATE_FILE:-/run/librescoot/ppp-link-rate}"
STATE_DIR="${PPP_RATE_STATE_DIR:-/run/librescoot}"
SET_RATE="${PPP_SET_RATE:-/usr/libexec/ppp-link-set-rate}"
REDIS_CLI="${REDIS_CLI:-redis-cli}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
SYSTEMD_RUN="${SYSTEMD_RUN:-systemd-run}"
PING="${PING:-ping}"
SLEEP="${SLEEP:-sleep}"
POLL_INTERVAL="${PPP_RATE_POLL_INTERVAL:-2}"
WATCH_FAILURES="${PPP_RATE_WATCH_FAILURES:-5}"
STABLE_CHECKS="${PPP_RATE_STABLE_CHECKS:-10}"
MAX_ATTEMPTS="${PPP_RATE_MAX_ATTEMPTS:-3}"
RETRY_DELAY="${PPP_RATE_RETRY_DELAY:-30}"
SWITCH_DELAY="${PPP_RATE_SWITCH_DELAY:-3}"
PREPARE_TIMEOUT="${PPP_RATE_PREPARE_TIMEOUT:-15}"
CONFIRM_TIMEOUT="${PPP_RATE_CONFIRM_TIMEOUT:-30}"
ROLLBACK_DELAY="${PPP_RATE_ROLLBACK_DELAY:-45}"
PREFIX="ppp-link:rate"
PEER_CONFIG="${PPP_PEER_CONFIG:-/etc/ppp/peers/uart-link}"

mkdir -p "$STATE_DIR"

if grep -q '^192\.168\.8\.1:192\.168\.8\.2$' "$PEER_CONFIG"; then
    ROLE=mdb
    REDIS_HOST=127.0.0.1
elif grep -q '^192\.168\.8\.2:192\.168\.8\.1$' "$PEER_CONFIG"; then
    ROLE=dbc
    REDIS_HOST=192.168.8.1
else
    echo "cannot determine PPP role" >&2
    exit 1
fi

redis() {
    "$REDIS_CLI" --raw -h "$REDIS_HOST" "$@" 2>/dev/null
}

redis_get() {
    redis GET "$1"
}

redis_set() {
    redis SET "$1" "$2" EX "$3" >/dev/null
}

current_rate() {
    if [ -r "$RATE_FILE" ]; then
        cat "$RATE_FILE"
    else
        printf '%s\n' "$BASE_RATE"
    fi
}

cancel_unit() {
    "$SYSTEMCTL" stop "$1.timer" >/dev/null 2>&1 || true
    "$SYSTEMCTL" stop "$1.service" >/dev/null 2>&1 || true
    "$SYSTEMCTL" reset-failed "$1.timer" "$1.service" >/dev/null 2>&1 || true
}

arm_rollback() {
    cancel_unit ppp-link-rate-fallback
    "$SYSTEMD_RUN" --quiet --collect --unit=ppp-link-rate-fallback \
        --on-active="${ROLLBACK_DELAY}s" "$SET_RATE" "$BASE_RATE"
}

schedule_switch() {
    cancel_unit ppp-link-rate-switch
    "$SYSTEMD_RUN" --quiet --collect --unit=ppp-link-rate-switch \
        --on-active="${SWITCH_DELAY}s" "$SET_RATE" "$TARGET_RATE"
}

rate_change_allowed() {
    OTA_STATUS=$(redis HGET ota status)
    [ "$(redis HGET usb mode)" = normal ] &&
        [ "$(redis HGET usb status)" = idle ] &&
        [ "$(redis HGET vehicle dbc-updating)" != true ] &&
        { [ -z "$OTA_STATUS" ] || [ "$OTA_STATUS" = idle ]; }
}

new_token() {
    if [ -r /proc/sys/kernel/random/uuid ]; then
        cat /proc/sys/kernel/random/uuid
    else
        printf '%s-%s\n' "$(date +%s)" "$$"
    fi
}

wait_for_value() {
    KEY="$1"
    VALUE="$2"
    LIMIT="$3"
    ELAPSED=0
    while [ "$ELAPSED" -lt "$LIMIT" ]; do
        [ "$(redis_get "$KEY")" = "$VALUE" ] && return 0
        "$SLEEP" 1
        ELAPSED=$((ELAPSED + 1))
    done
    return 1
}

watch_target_rate() {
    if [ "$ROLE" = mdb ]; then
        PEER=192.168.8.2
    else
        PEER=192.168.8.1
    fi

    FAILURES=0
    SUCCESSES=0
    while [ "$(current_rate)" = "$TARGET_RATE" ]; do
        if ! "$SYSTEMCTL" is-active --quiet ppp-link.service; then
            PPP_RATE_NO_RESTART=1 "$SET_RATE" "$BASE_RATE"
            return 0
        fi
        if "$PING" -c 1 -W 1 "$PEER" >/dev/null 2>&1; then
            FAILURES=0
            SUCCESSES=$((SUCCESSES + 1))
            if [ "$ROLE" = mdb ] && [ "$SUCCESSES" -ge "$STABLE_CHECKS" ]; then
                rm -f "$STATE_DIR/ppp-rate-attempts"
            fi
        else
            FAILURES=$((FAILURES + 1))
            if [ "$FAILURES" -ge "$WATCH_FAILURES" ]; then
                "$SET_RATE" "$BASE_RATE"
                return 1
            fi
        fi
        "$SLEEP" "$POLL_INTERVAL"
    done
}

run_dbc() {
    LAST_TOKEN=
    [ -r "$STATE_DIR/ppp-rate-dbc-last-token" ] &&
        LAST_TOKEN=$(cat "$STATE_DIR/ppp-rate-dbc-last-token")
    while :; do
        if ! redis_set "$PREFIX:dbc-capable" 1 10; then
            "$SLEEP" "$POLL_INTERVAL"
            continue
        fi

        TOKEN=$(redis_get "$PREFIX:command")
        if [ -z "$TOKEN" ] || [ "$TOKEN" = "$LAST_TOKEN" ]; then
            "$SLEEP" "$POLL_INTERVAL"
            continue
        fi
        if ! rate_change_allowed || ! arm_rollback; then
            "$SLEEP" "$POLL_INTERVAL"
            continue
        fi

        LAST_TOKEN="$TOKEN"
        printf '%s\n' "$TOKEN" > "$STATE_DIR/ppp-rate-dbc-last-token"
        redis_set "$PREFIX:prepared" "$TOKEN" "$PREPARE_TIMEOUT" || continue
        if ! wait_for_value "$PREFIX:go" "$TOKEN" "$PREPARE_TIMEOUT"; then
            cancel_unit ppp-link-rate-fallback
            continue
        fi
        schedule_switch || continue

        "$SLEEP" "$((SWITCH_DELAY + 2))"
        ELAPSED=0
        while [ "$ELAPSED" -lt "$CONFIRM_TIMEOUT" ]; do
            if [ "$(current_rate)" = "$TARGET_RATE" ] && redis PING >/dev/null; then
                redis_set "$PREFIX:confirmed" "$TOKEN" "$CONFIRM_TIMEOUT" || true
                if wait_for_value "$PREFIX:commit" "$TOKEN" "$CONFIRM_TIMEOUT"; then
                    cancel_unit ppp-link-rate-fallback
                    redis_set "$PREFIX:committed" "$TOKEN" "$CONFIRM_TIMEOUT" || true
                    touch "$STATE_DIR/ppp-rate-negotiated"
                    watch_target_rate
                    return $?
                fi
                return 1
            fi
            "$SLEEP" 1
            ELAPSED=$((ELAPSED + 1))
        done
    done
}

run_mdb() {
    ATTEMPTS=0
    [ -r "$STATE_DIR/ppp-rate-attempts" ] &&
        ATTEMPTS=$(cat "$STATE_DIR/ppp-rate-attempts")

    while [ "$ATTEMPTS" -lt "$MAX_ATTEMPTS" ]; do
        if [ "$(redis_get "$PREFIX:dbc-capable")" != 1 ] || ! rate_change_allowed; then
            "$SLEEP" "$POLL_INTERVAL"
            continue
        fi

        ATTEMPTS=$((ATTEMPTS + 1))
        printf '%s\n' "$ATTEMPTS" > "$STATE_DIR/ppp-rate-attempts"
        TOKEN=$(new_token)
        redis DEL "$PREFIX:prepared" "$PREFIX:go" "$PREFIX:confirmed" \
            "$PREFIX:commit" "$PREFIX:committed" >/dev/null
        if ! redis_set "$PREFIX:command" "$TOKEN" "$PREPARE_TIMEOUT" ||
            ! wait_for_value "$PREFIX:prepared" "$TOKEN" "$PREPARE_TIMEOUT"; then
            "$SLEEP" "$RETRY_DELAY"
            continue
        fi

        if ! rate_change_allowed || ! arm_rollback; then
            "$SLEEP" "$RETRY_DELAY"
            continue
        fi
        if ! redis_set "$PREFIX:go" "$TOKEN" "$PREPARE_TIMEOUT" || ! schedule_switch; then
            "$SLEEP" "$RETRY_DELAY"
            continue
        fi

        "$SLEEP" "$((SWITCH_DELAY + 2))"
        if wait_for_value "$PREFIX:confirmed" "$TOKEN" "$CONFIRM_TIMEOUT" &&
            [ "$(current_rate)" = "$TARGET_RATE" ]; then
            redis_set "$PREFIX:commit" "$TOKEN" "$CONFIRM_TIMEOUT" || return 1
            if wait_for_value "$PREFIX:committed" "$TOKEN" "$CONFIRM_TIMEOUT"; then
                cancel_unit ppp-link-rate-fallback
                touch "$STATE_DIR/ppp-rate-negotiated"
                watch_target_rate
                return $?
            fi
        fi
        "$SLEEP" "$RETRY_DELAY"
    done
    return 0
}

if [ "$(current_rate)" = "$TARGET_RATE" ]; then
    watch_target_rate
elif [ "$ROLE" = mdb ]; then
    run_mdb
else
    run_dbc
fi
